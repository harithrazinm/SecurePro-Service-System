# Local development: relative to the backend working directory.
MEDIA_STORAGE_PROVIDER=local
STORAGE_ROOT=./securepro-storage

# Production: replace STORAGE_ROOT with an absolute path outside public_html.
# STORAGE_ROOT=/home/your-cpanel-user/securepro-storage

# Optional: location of legacy files referenced by /uploads/... in the database.
# If omitted, the application resolves the repository's backend/uploads folder.
# LEGACY_UPLOADS_ROOT=/home/your-cpanel-user/legacy-uploads

# Optional dedicated HMAC key for short-lived private media URLs.
# If omitted, the existing JWT_SECRET is reused. Use a long random value if set.
# MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret

# Required only for absolute media links in quotation/invoice emails.
# PUBLIC_APP_URL=https://your-domain.example
