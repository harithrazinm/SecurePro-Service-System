# Local development: relative to the backend working directory.
MEDIA_STORAGE_PROVIDER=local
STORAGE_ROOT=./securepro-storage

# Production: replace STORAGE_ROOT with an absolute path outside public_html.
# STORAGE_ROOT=/home/your-cpanel-user/securepro-storage

# Optional: location of legacy files referenced by /uploads/... in the database.
# If omitted, the application resolves the repository's backend/uploads folder.
# LEGACY_UPLOADS_ROOT=/home/your-cpanel-user/legacy-uploads

# Optional dedicated HMAC key for short-lived private media URLs.
# If omitted, the existing JWT_SECRET is reused. Use a long random value if set.
# MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret

# Required only for absolute media links in quotation/invoice emails.
# PUBLIC_APP_URL=https://your-domain.example

# Optional private directory for application errors/warnings. Defaults to backend/logs.
# Keep this path outside public_html on production hosting.
# APP_ERROR_LOG_DIR=/home/your-cpanel-user/private/securepro-logs

# Optional exact browser origins for local/tunnel testing (comma-separated).
# Add the current HTTPS ngrok origin here; do not use a wildcard.
# CORS_ALLOWED_ORIGINS=https://your-current-name.ngrok-free.dev

# Required for Super Admin quotation-review alerts. This is independent of
# the Super Admin login email stored in the users table.
# SUPER_ADMIN_NOTIFICATION_EMAIL=superadmin-notifications@example.com

# Standard Web Push for Super Admin browser/device notifications.
# Generate a VAPID pair with: npx web-push generate-vapid-keys --json
# The public key is returned by the authenticated /api/super-admin/push-config endpoint.
# Keep the private key only in this backend environment; never commit it.
# WEB_PUSH_VAPID_PUBLIC_KEY=your_public_vapid_key
# WEB_PUSH_VAPID_PRIVATE_KEY=your_private_vapid_key
# WEB_PUSH_SUBJECT=mailto:harithrazinm@gmail.com
